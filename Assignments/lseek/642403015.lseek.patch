diff --git a/sysfile.c b/sysfile.c
index bfe61b7..ad6b82f 100644
--- a/sysfile.c
+++ b/sysfile.c
@@ -442,3 +442,56 @@ sys_pipe(void)
   fd[1] = fd1;
   return 0;
 }
+
+// lseeek sys call handler 
+int
+sys_lseek(void)
+{
+  struct file *f;
+  int fd;
+  int offset;
+  int whence;	// it tells from where the ofset must be added
+  struct inode *ip;
+  uint fsize = 0;
+  int base = 0;	// starting point depends on whence 
+  long long calc = 0;	// calculated offset after adding whence
+
+  if(argfd(0, &fd, &f) < 0)
+    return -1;
+  if(argint(1, &offset) < 0)
+    return -1;
+  if(argint(2, &whence) < 0)
+    return -1;
+
+  // Only inode-backed regular files are seekable
+  if(f->type != FD_INODE)
+    return -1;
+
+  ip = f->ip;
+  if(ip == 0)
+    return -1;
+
+  // Disallow directories and devices
+  if(ip->type != T_FILE)
+    return -1;
+
+  ilock(ip);
+  fsize = ip->size;
+  iunlock(ip);
+
+  switch(whence){
+    case SEEK_SET: base = 0; break;
+    case SEEK_CUR: base = f->off; break;
+    case SEEK_END: base = fsize; break;
+    default: return -1;
+  }
+
+  calc = (long long)base + (long long)offset;
+
+  if(calc < 0 || calc > (long long)fsize)
+    return -1;
+
+  f->off = (uint)calc;
+  return f->off;
+}
+
